#!/usr/bin/env bash
set -euo pipefail
prefix=/opt/mac-steam-ultimate/current
cache=${XDG_CACHE_HOME:-$HOME/.cache}/mac-steam-ultimate
mkdir -p "$cache"
if [[ -f $cache/client.log && $(stat -c %s "$cache/client.log") -gt 10485760 ]]; then
    mv -f "$cache/client.log" "$cache/client.log.previous"
fi
exec >> "$cache/client.log" 2>&1
python3 "$prefix/runtime/prepare.py" --watch &
watcher=$!
trap 'kill "$watcher" 2>/dev/null || :' EXIT
steam "$@"
