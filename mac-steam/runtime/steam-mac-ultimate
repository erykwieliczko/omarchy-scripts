#!/usr/bin/env bash
set -euo pipefail
prefix=/opt/mac-steam-ultimate/current
if (( EUID == 0 )); then
    echo 'Start Steam from your desktop account, not root.' >&2
    exit 1
fi
if [[ ${1:-} == --prepare ]]; then
    exec python3 "$prefix/runtime/prepare.py"
fi
backend=${MAC_STEAM_BACKEND:-auto}
case ${1:-} in
    --native) backend=native; shift ;;
    --muvm) backend=muvm; shift ;;
esac
case $backend in auto|native|muvm) ;; *) echo 'Backend must be auto, native or muvm.' >&2; exit 2 ;; esac
root=$(readlink -e "$HOME/.steam/steam" || :)
root=${root:-${XDG_DATA_HOME:-$HOME/.local/share}/Steam}
mkdir -p "$HOME/.steam" "${XDG_CACHE_HOME:-$HOME/.cache}/mac-steam-ultimate"
for link in sdk32:linux32 sdk64:linux64 bin32:ubuntu12_32 bin64:ubuntu12_64; do
    dest=$HOME/.steam/${link%%:*}
    if [[ -e $dest && ! -L $dest ]]; then
        echo "Cannot replace existing directory: $dest" >&2
        exit 1
    fi
    ln -sfn "$root/${link#*:}" "$dest"
done
python3 "$prefix/runtime/prepare.py"
native_supported=0
if [[ -x $prefix/userpages/bin/userpages ]] &&
        [[ $("$prefix/userpages/bin/userpages" 4k /usr/bin/getconf PAGESIZE 2>/dev/null) == 4096 ]]; then
    native_supported=1
fi
if [[ $backend == native || ( $backend == auto && $native_supported == 1 ) ]]; then
    (( native_supported )) || {
        echo 'Native 4 KB mode is unavailable. Reboot after installing, or use --muvm.' >&2
        exit 1
    }
    exec /usr/bin/pkexec --disable-internal-agent /usr/local/libexec/mac-steam-native "$@"
fi
if pgrep -u "$(id -u)" -x steam >/dev/null; then
    echo 'Close native Steam and its games before switching to muvm.' >&2
    exit 1
fi
echo 'Steam Ultimate: using muvm (steam-mac-ultimate --native selects native 4 KB mode).'
export PATH="$prefix/fex/bin:$PATH"
exec python3 "$prefix/runtime/with-gamemode.py" \
    muvm --emu=fex -e "PATH=$PATH" -x "$prefix/runtime/guest-setup" \
    --fex-image /usr/share/fex-emu/RootFS/default.erofs \
    --fex-image "$prefix/overlays/mesa-i386.erofs" \
    --fex-image "$prefix/overlays/mesa-x86_64.erofs" \
    -- "$prefix/runtime/guest-steam" "$@"
