From 61663da5bc8391130e4d3fdf0797f0ff9fe44161 Mon Sep 17 00:00:00 2001
From: jgoyvaerts <1125884+jgoyvaerts@users.noreply.github.com>
Date: Sun, 1 Nov 2026 19:58:02 -0300
Subject: [PATCH] FEXCore: compile a guest entry once when threads miss on it
 together

Threads running the same code miss on the same entry at the same time.
Nothing stopped each of them compiling it, so every thread emitted its
own copy. The copies fill the code buffer, the clear that follows makes
all of them miss together again, and each finished compile queues on
the lookup cache write lock once per entry point.

Take a per-entry lock around the compile and look the entry up again
when it is this thread's turn. The locks are striped by a hash of the
RIP, so two entries only wait on each other if they collide. Generated
code doesn't change.

Forking takes CodeInvalidationMutex exclusively and the compile holds it
shared, so no compile lock can be held across a fork.

concurrent_compile counts compiles through FEX's own stats, so it doesn't
depend on timing.
---
 FEXCore/Source/Interface/Context/Context.h    |   3 +
 FEXCore/Source/Interface/Core/Core.cpp        |   8 +
 unittests/FEXLinuxTests/CMakeLists.txt        |   3 +
 unittests/FEXLinuxTests/tests/CMakeLists.txt  |   4 +
 .../tests/cpu/concurrent_compile.64.cpp       | 142 ++++++++++++++++++
 5 files changed, 160 insertions(+)
 create mode 100644 unittests/FEXLinuxTests/tests/cpu/concurrent_compile.64.cpp

diff --git a/FEXCore/Source/Interface/Context/Context.h b/FEXCore/Source/Interface/Context/Context.h
index 9b91055bd0..21655dc15e 100644
--- a/FEXCore/Source/Interface/Context/Context.h
+++ b/FEXCore/Source/Interface/Context/Context.h
@@ -20,6 +20,7 @@
 #include <FEXCore/fextl/unordered_map.h>
 #include <FEXCore/fextl/vector.h>
 
+#include <array>
 #include <atomic>
 #include <cstddef>
 #include <cstdint>
@@ -380,6 +381,8 @@ class ContextImpl final : public FEXCore::Context::Context, public CPU::SharedCo
   bool HostRNGAvailable {};
 
   FEXCore::Utils::WritePriorityMutex::Mutex CodeInvalidationMutex {};
+  // Taken while compiling a guest entry, by hash of its RIP. See CompileBlock.
+  std::array<FEXCore::Utils::WritePriorityMutex::Mutex, 1024> EntryCompileLocks {};
 
   uint32_t StrictSplitLockMutex {};
 
diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 63280a42a3..2bf2e7568c 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -875,6 +875,14 @@ uintptr_t ContextImpl::CompileBlock(FEXCore::Core::CpuStateFrame* Frame, uint64_
     return HostCode;
   }
 
+  // Threads running the same code miss on the same entry at the same time. If they each compile it, the copies fill the code
+  // buffer and the clear that follows makes all of them miss together again. So take turns, and look again when it's our turn.
+  // No fork can see this held: forking takes CodeInvalidationMutex exclusively.
+  std::lock_guard EntryCompileLock(EntryCompileLocks[(GuestRIP ^ (GuestRIP >> 10) ^ (GuestRIP >> 20)) % EntryCompileLocks.size()]);
+  if (auto HostCode = Thread->LookupCache->FindBlock(Thread, GuestRIP)) {
+    return HostCode;
+  }
+
   Thread->FrontendDecoder->SetupDecodeInstructionsAtEntry(Thread, GuestRIP, MaxInst);
 
   std::optional<ExecutableFileSectionInfo> Region = SyscallHandler->LookupExecutableFileSection(Thread, GuestRIP);
