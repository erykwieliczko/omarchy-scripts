     const auto InstSize = DecodeInst->InstSize;
     DecodeInst->TableInfo = nullptr;
     DecodeInst->InstSize = 0;
+    // Keep the consumed bytes for hot-page verification without changing
+    // the fault RIP. Never emit loads from a non-executable fetch range.
+    if (!HitNonExecutableRange) {
+      DecodeInst->DecodeFailureSize = std::min<uint8_t>(InstructionSize, 15);
+    }
 
     // A decode error can be caused by substituting zero for an inaccessible
