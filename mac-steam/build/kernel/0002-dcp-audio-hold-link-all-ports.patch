From 653176dcb94ed7253763428f1f8522cb4685e496 Mon Sep 17 00:00:00 2001
From: Eryk Wieliczko <eryk@wieliczko.ninja>
Date: Fri, 30 Oct 2026 20:32:06 +0100
Subject: [PATCH] drm/apple: hold the audio link on the Type-C ports too

A stereo audio link is held between streams so that the sink does not
mute it on a restart with the same format. The hold_link parameter
limited that to the HDMI port by default (hold_link=1) until the Type-C
ports had been tested with it; hold_link=2 extended it to them and 0
turned it off.

On the J514S, a TV on a Type-C port behaves as it does on the HDMI port:
without the hold, every stream starts a new link with an unchanged
format, the TV mutes it, and USB-C audio stays silent after the first
stream. With hold_link=2 it played across Chromium stop/start, pw-play
runs and a PipeWire restart, and held links survived 90 s idle and
sleep.

Hold the link on every port and drop the parameter. Nothing needs to
turn the hold off, and a parameter that only makes audio go silent is
not worth keeping. Streams of more than two channels still get a link
of their own, as before.

Signed-off-by: Eryk Wieliczko <eryk@wieliczko.ninja>
Assisted-by: Claude:claude-opus-5-5
---
 drivers/gpu/drm/apple/audio-link-test.c | 44 -------------------------
 drivers/gpu/drm/apple/audio.c           | 42 +++++++----------------
 drivers/gpu/drm/apple/audio.h           |  2 --
 drivers/gpu/drm/apple/av.c              |  6 ----
 4 files changed, 11 insertions(+), 83 deletions(-)

diff --git a/drivers/gpu/drm/apple/audio-link-test.c b/drivers/gpu/drm/apple/audio-link-test.c
index 40f928396297..0ddd42dce072 100644
--- a/drivers/gpu/drm/apple/audio-link-test.c
+++ b/drivers/gpu/drm/apple/audio-link-test.c
@@ -12,7 +12,6 @@
 struct dcpaud_link_test {
 	bool link_on;
 	bool link_live;
-	bool typec;
 	/* The error removing the idle transfer returns */
 	int idle_remove_err;
 	u64 asked;
@@ -40,11 +39,6 @@ static bool dcpaud_link_test_live(struct device *dev)
 	return dcpaud_link_current->link_live;
 }
 
-static bool dcpaud_link_test_typec(struct device *dev)
-{
-	return dcpaud_link_current->typec;
-}
-
 static int dcpaud_link_test_terminate(struct dma_chan *chan)
 {
 	dcpaud_link_record('X');
@@ -147,7 +141,6 @@ static struct dcp_audio *dcpaud_link_setup(struct kunit *test, struct platform_d
 	kunit_activate_static_stub(test, dcp_audiosrv_link_on, dcpaud_link_test_on);
 	kunit_activate_static_stub(test, dcp_audiosrv_link_live, dcpaud_link_test_live);
 	kunit_activate_static_stub(test, dcp_audiosrv_link, dcpaud_link_test_call);
-	kunit_activate_static_stub(test, dcp_audiosrv_typec, dcpaud_link_test_typec);
 	return dcpaud;
 }
 
@@ -451,42 +444,6 @@ static void dcpaud_close_keeps_held_silence(struct kunit *test)
 	pm_runtime_put_noidle(audio->dev);
 }
 
-static void dcpaud_link_test_hold_default(void *data)
-{
-	WRITE_ONCE(hold_link, 1);
-}
-
-static void dcpaud_typec_stop_ends_stream(struct kunit *test)
-{
-	struct platform_device *pdev;
-	struct dcp_audio *audio = dcpaud_link_setup(test, &pdev);
-	struct snd_pcm_substream *sub = dcpaud_link_test_open(test, audio);
-
-	KUNIT_ASSERT_EQ(test,
-			kunit_add_action_or_reset(test, dcpaud_link_test_hold_default, NULL), 0);
-	sub->runtime->channels = 2;
-	sub->runtime->dma_area = kunit_kzalloc(test, 64, GFP_KERNEL);
-	KUNIT_ASSERT_NOT_NULL(test, sub->runtime->dma_area);
-	sub->runtime->dma_bytes = 64;
-	dcpaud_link_current->typec = true;
-
-	/* USB-C by default: STOP ends the stream's DMA, no link is held */
-	audio->stream_dma = true;
-	pm_runtime_get_noresume(audio->dev);
-	KUNIT_ASSERT_EQ(test, dcp_pcm_native_trigger(sub, SNDRV_PCM_TRIGGER_STOP), 0);
-	KUNIT_EXPECT_STREQ(test, dcpaud_link_current->sequence, "X");
-	KUNIT_EXPECT_FALSE(test, audio->dma_cleared);
-	KUNIT_EXPECT_EQ(test, atomic_read(&audio->dev->power.usage_count), 0);
-
-	/* hold_link=2: the DMA plays the cleared buffer on for the held link */
-	WRITE_ONCE(hold_link, 2);
-	pm_runtime_get_noresume(audio->dev);
-	KUNIT_ASSERT_EQ(test, dcp_pcm_native_trigger(sub, SNDRV_PCM_TRIGGER_STOP), 0);
-	KUNIT_EXPECT_STREQ(test, dcpaud_link_current->sequence, "X");
-	KUNIT_EXPECT_TRUE(test, audio->dma_cleared);
-	pm_runtime_put_noidle(audio->dev);
-}
-
 static struct kunit_case dcpaud_link_cases[] = {
 	KUNIT_CASE(dcpaud_link_release_instance),
 	KUNIT_CASE(dcpaud_disconnect_sync_completes_live_owner),
@@ -499,7 +456,6 @@ static struct kunit_case dcpaud_link_cases[] = {
 	KUNIT_CASE(dcpaud_start_after_held_link_went),
 	KUNIT_CASE(dcpaud_failed_start_keeps_held_link),
 	KUNIT_CASE(dcpaud_close_keeps_held_silence),
-	KUNIT_CASE(dcpaud_typec_stop_ends_stream),
 	{}
 };
 
diff --git a/drivers/gpu/drm/apple/audio.c b/drivers/gpu/drm/apple/audio.c
index 14bd1129fb84..7c5c249dff11 100644
--- a/drivers/gpu/drm/apple/audio.c
+++ b/drivers/gpu/drm/apple/audio.c
@@ -655,12 +655,12 @@ struct snd_pcm_ops dcp_playback_ops = {
  * service itself is open while the PCM is, or while its link is held.
  */
 /*
- * The sink behind the J514S HDMI port (PS190 converter and TV) mutes the
- * audio of a link that stops and starts again with an unchanged format,
- * until the DP link trains again: only a different channel layout brings
- * it back. So a stereo link, once started, is held between streams, as
- * macOS holds it: silence follows the stopped stream's DMA and the link
- * keeps running until the format changes or the display goes off
+ * The sinks behind the J514S HDMI port (PS190 converter and TV) and its
+ * Type-C ports mute the audio of a link that stops and starts again with an
+ * unchanged format, until the DP link trains again: only a different channel
+ * layout brings it back. So a stereo link, once started, is held between
+ * streams, as macOS holds it: silence follows the stopped stream's DMA and
+ * the link keeps running until the format changes or the display goes off
  * (dcpaud_release_link()).
  *
  * The link must not run dry either: a gap of 20 ms in its samples mutes the
@@ -668,26 +668,6 @@ struct snd_pcm_ops dcp_playback_ops = {
  * the channel issues whenever no stream's DMA does, in descriptor order:
  * a stream's DMA takes over from it and hands back to it without a gap.
  */
-/*
- * Read-only at runtime: a stream opened while it was lower keeps periods
- * longer than a held link's synchronize allows for.
- */
-static int hold_link = 1;
-module_param(hold_link, int, 0444);
-MODULE_PARM_DESC(hold_link,
-		 "Hold started audio links between streams (silence): 0 never, 1 on the HDMI port (default), 2 also on USB-C");
-
-/*
- * The mute was measured behind the HDMI port. USB-C sinks keep one link per
- * stream unless hold_link=2, until they have been qualified with this.
- */
-static bool dcpaud_holds(struct dcp_audio *dcpaud)
-{
-	int hold = READ_ONCE(hold_link);
-
-	return hold >= 2 || (hold == 1 && !dcp_audiosrv_typec(dcpaud->dcp_dev));
-}
-
 /*
  * A change of sample rate or sample size with an unchanged channel layout
  * replaces the link with a new one, which this sink mutes just as it does a
@@ -879,7 +859,7 @@ static int dcp_pcm_native_open(struct snd_pcm_substream *substream)
 	}
 
 	ret = dcp_pcm_open(substream);
-	if (!ret && live && !dcpaud->open_unplugged && dcpaud_holds(dcpaud)) {
+	if (!ret && live && !dcpaud->open_unplugged) {
 		ret = dcpaud_pin_rate_format(dcpaud, substream->runtime);
 		if (!ret)
 			ret = snd_pcm_hw_constraint_minmax(substream->runtime,
@@ -1043,8 +1023,8 @@ static int dcp_pcm_native_start(struct snd_pcm_substream *substream, int cmd)
 	/* The first link of the connection waits for the sink to settle. */
 	scoped_guard(mutex, &dcpaud->data_lock)
 		up_ms = ktime_ms_delta(ktime_get(), dcpaud->connected_at);
-	if (dcpaud_holds(dcpaud) && !READ_ONCE(dcpaud->link_started) &&
-	    up_ms >= 0 && up_ms < DCPAUD_SINK_SETTLE_MS) {
+	if (!READ_ONCE(dcpaud->link_started) && up_ms >= 0 &&
+	    up_ms < DCPAUD_SINK_SETTLE_MS) {
 		dev_dbg(dcpaud->dev, "sink up %lld ms, link waits\n", up_ms);
 		msleep(DCPAUD_SINK_SETTLE_MS - up_ms);
 	}
@@ -1117,8 +1097,8 @@ static int dcp_pcm_native_trigger(struct snd_pcm_substream *substream, int cmd)
 		 * reference, until sync_stop hands over to the held link's
 		 * silence: the link must not run dry meanwhile.
 		 */
-		if (dcpaud_holds(dcpaud) && READ_ONCE(dcpaud->stream_dma) &&
-		    substream->runtime->channels == 2 && substream->runtime->dma_area) {
+		if (READ_ONCE(dcpaud->stream_dma) && substream->runtime->channels == 2 &&
+		    substream->runtime->dma_area) {
 			memset(substream->runtime->dma_area, 0, substream->runtime->dma_bytes);
 			WRITE_ONCE(dcpaud->dma_cleared, true);
 			return 0;
diff --git a/drivers/gpu/drm/apple/audio.h b/drivers/gpu/drm/apple/audio.h
index 259703b55fb2..dcf752efb9a1 100644
--- a/drivers/gpu/drm/apple/audio.h
+++ b/drivers/gpu/drm/apple/audio.h
@@ -37,8 +37,6 @@ void dcpaud_release_link(struct platform_device *pdev, const u64 *gen);
 bool dcp_audiosrv_link_on(struct device *dev, u64 gen);
 /* The prepared link still belongs to the client of the published instance. */
 bool dcp_audiosrv_link_live(struct device *dev);
-/* The display processor drives a Type-C route rather than the HDMI port. */
-bool dcp_audiosrv_typec(struct device *dev);
 #endif
 
 #endif /* __AUDIO_H__ */
diff --git a/drivers/gpu/drm/apple/av.c b/drivers/gpu/drm/apple/av.c
index e5b987be12c2..c0bacc9956d3 100644
--- a/drivers/gpu/drm/apple/av.c
+++ b/drivers/gpu/drm/apple/av.c
@@ -400,12 +400,6 @@ bool dcp_audiosrv_link_live(struct device *dev)
 	return asrv->link_gen == asrv->open_gen && av_audiosrv_open_published(asrv);
 }
 
-bool dcp_audiosrv_typec(struct device *dev)
-{
-	KUNIT_STATIC_STUB_REDIRECT(dcp_audiosrv_typec, dev);
-	return dcp_is_typec_output(dev_get_drvdata(dev));
-}
-
 /*
  * The link commands of the 14.7 external role's audio service, the native
  * audio driver's: prepare, start, stop and complete all take the selected
-- 
