#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=/dev/null
source /usr/local/lib/omarchy-kde/session-env.sh
export XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE XDG_SESSION_TYPE=wayland
# A previous UWSM login can leave these in the shared user manager.
systemctl --user unset-environment HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD \
    HYPRCURSOR_THEME HYPRCURSOR_SIZE GDK_SCALE GDK_DPI_SCALE QT_SCALE_FACTOR \
    QT_SCREEN_SCALE_FACTORS QT_QPA_PLATFORM QT_STYLE_OVERRIDE QT_IM_MODULE GTK_THEME DISPLAY WAYLAND_DISPLAY || :
unset DISPLAY WAYLAND_DISPLAY
dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE OMARCHY_PATH PATH QT_QPA_PLATFORMTHEME
exec /usr/lib/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
